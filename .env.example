# Copy to .env and adjust. Never commit the real .env.
NEXUS_ENV=development
# Required, no default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///nexus.db

# CRM: "mock" (no account needed) or "hubspot"
CRM_PROVIDER=mock
# HUBSPOT_TOKEN=pat-na1-...            # private app token, required when CRM_PROVIDER=hubspot
# HUBSPOT_PROMOTER_PROPERTY=nexus_promoter_id

# Shared secret for /internal/* (called by Cloud Scheduler). Required in production.
# INTERNAL_TOKEN=

# White-label
BRAND_NAME=Nexus
BRAND_PRIMARY_COLOR=#4f46e5
# BRAND_LOGO_URL=https://example.com/logo.svg

# Demo mode: seeds sample data on start and shows the demo credentials on the login page
DEMO_MODE=false
